# OPENAI API KEY para el motor conversacional
OPENAI_API_KEY

# Nombre de la tienda para el contexto del bot
STORE_NAME="Mi Tienda Online"

# Credenciales para el Panel de Control
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin123

# Número de puerto
PORT=3000

# ── Supabase (base de datos Postgres + Storage de imágenes) ──
# URL del proyecto: Dashboard → Project Settings → Data API
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Clave pública: Dashboard → Project Settings → API Keys → publishable/anon key
SUPABASE_ANON_KEY=
# Opcional (recomendado para backend): service_role key, omite las políticas RLS
# SUPABASE_SERVICE_ROLE_KEY=

# Claves para la subida de imágenes (LEGACY: ahora se usa Supabase Storage)
CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET

# Ruta al JSON de cuenta de servicio de Google (solo para Google Calendar).
# Por defecto se usa el archivo firebase-key.json de la raíz (nombre histórico).
# GOOGLE_SERVICE_ACCOUNT_PATH=firebase-key.json
