# ─── REQUERIDO: OpenAI ───
# API Key para el motor conversacional (GPT-4o-mini)
OPENAI_API_KEY=sk-...

# (Opcional) Segunda API key para balanceo de carga
# OPENAI_API_KEY_2=sk-...
# (Opcional) URL base personalizada (ej: proxy o Azure)
# OPENAI_BASE_URL=https://api.openai.com/v1
# (Opcional) Modelo a usar (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# ─── OPCIONAL: Tienda de donde se lee el catálogo ───
# El bot lee las piezas publicadas de la API pública de la tienda (sin credenciales).
# SITE_URL=https://www.mr18kts.online
# Minutos que se guarda en memoria, en milisegundos (default 5 min)
# CATALOG_CACHE_MS=300000

# ─── REQUERIDO: Base de datos (sesiones de chat y citas del bot) ───
# Base de la tienda en Supabase, esquema `bot`, rol `bot_joyeria` (solo bot.sessions y bot.appointments).
# Transaction pooler (puerto 6543). Se crea con supabase/002_bot_schema.sql (ver supabase/README.md).
BOT_DATABASE_URL=postgresql://bot_joyeria.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Certificado de Supabase para verificar TLS (Database → Settings → SSL Configuration → Download certificate).
# BOT_DATABASE_CA_PATH=supabase-ca.crt
# Días sin actividad tras los que se borra un chat (Ley 1581; las citas se conservan). Default 90.
# BOT_SESSION_RETENTION_DAYS=90
# Coexistencia: horas que el bot se aparta de un chat cuando la joyería contesta desde el celular. Default 4.
# HUMAN_TAKEOVER_HOURS=4

# ─── REQUERIDO: WhatsApp Cloud API oficial de Meta ───
# El access token y el App Secret nunca deben compartirse ni subirse al repositorio.
META_ACCESS_TOKEN=
META_PHONE_ID=
META_WABA_ID=
META_APP_SECRET=
# Cadena elegida por el proyecto y repetida en la configuración del webhook de Meta.
META_VERIFY_TOKEN=
# Usa una versión Graph API soportada por Meta.
META_API_VERSION=v26.0

# ─── OPCIONAL: Comportamiento del bot en WhatsApp ───
# Mensajes consecutivos del mismo cliente se agrupan en una sola solicitud a la IA:
# se espera QUIET_MS de silencio tras el último mensaje, pero nunca más de MAX_WAIT_MS desde el primero.
# WHATSAPP_BATCH_QUIET_MS=3000
# WHATSAPP_BATCH_MAX_WAIT_MS=10000
# Conversaciones procesándose con la IA al mismo tiempo (protege el servidor y la cuota de la API).
# BOT_MAX_CONCURRENT_CONVERSATIONS=5
# Límites de calidad por mensaje entrante (no son límites oficiales de Meta).
# BOT_MAX_TEXT_MESSAGES=3
# BOT_MAX_IMAGES=3

# ─── REQUERIDO: Telegram ───
# Debes configurarlo en la base de datos (tabla `stores`)
# El bot se inicia automáticamente al detectar un token en la DB.

# ─── RECOMENDADO: Resend (Notificaciones por Email) ───
# 1. Regístrate en https://resend.com
# 2. Crea una API Key en Settings > API Keys
RESEND_API_KEY=re_...

# ─── RECOMENDADO: Google Calendar (Agendamiento de Citas) ───
# 1. Ve a https://console.cloud.google.com
# 2. Habilita la API de Google Calendar
# 3. Crea una Cuenta de Servicio y descarga el JSON
# 4. Renombra el archivo a google-service-account.json y colócalo en la raíz
# 5. O especifica una ruta personalizada:
# GOOGLE_SERVICE_ACCOUNT_PATH=google-service-account.json

# ─── RECOMENDADO: Cloudinary (Imágenes Legacy) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OPCIONAL: Ngrok (Túnel para desarrollo local) ───
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=

# ─── CONFIGURACIÓN GENERAL ───
STORE_NAME="Mr. 18Kilates"
PORT=3000
DASHBOARD_USER=admin
# Obligatoria: sin ella el panel no deja entrar. Mínimo 10 caracteres.
DASHBOARD_PASSWORD=
# Cadena larga y aleatoria (p. ej. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
